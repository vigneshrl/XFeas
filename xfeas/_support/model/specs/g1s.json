 "binding": {
  "adapter": "g1_sonic:make_g1s",
  "call": "dict",
  "names": {
   "vx": "vx",
   "vy": "vy",
   "wz": "wz",
   "speed": "speed",
   "body_height": "body_height",
   "mode": "mode"
  },
  "mode_values": "int id",
  "env": {
   "SONIC_PLANNER_ASYNC": "0"
  }
 },
 "doc_notes": [
  "planner inputs: movement_direction (world, normalised), facing_direction, target_vel (<=0 -> the mode's default velocity), mode (int), height (<0 disabled; >=0 nearest height keyframe of the clip)",
  "the harness bridge maps body-frame (vx, vy) to movement_direction + target_vel = |v| and integrates yaw_rate into facing_direction",
  "keyboard: speed ranges per mode (slowWalk 0.2-0.8, run 1.5-3.0, handCrawl 0.4-1.0, elbowCrawl 0.7-1.0, boxing 0.7-1.5); height adjustable 0.2-0.8 m in the squat/ground set",
  "keyboard tip: keep lateral (strafe) target velocity around 0.4 m/s",
  "vx/vy range +-0.8 = the slowWalk band (the nominal walking set); mode 'walk' has no documented range"
 ],
