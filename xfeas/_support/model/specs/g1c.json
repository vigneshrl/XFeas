{
 "schema": "xfeas.ctrl_spec/1",
 "robot": "unitree_g1",
 "virtual": false,
 "rate_hz": 50,
 "nominal": {
  "speed": 0.3
 },
 "ctrl_id": "g1c",
 "base": "g1c",
 "controller": "AMO (released, OpenTeleVision/AMO, amo_jit.pt + adapter_jit.pt)",
 "commands": [
  {
   "name": "vx",
   "role": "lin_vel_x",
   "type": "continuous",
   "unit": "m/s",
   "range": [
    -0.5,
    0.5
   ],
   "nominal": 0.0
  },
  {
   "name": "vy",
   "role": "lin_vel_y",
   "type": "continuous",
   "unit": "m/s",
   "range": [
    -0.4,
    0.4
   ],
   "nominal": 0.0
  },
  {
   "name": "wz",
   "role": "yaw_rate",
   "type": "continuous",
   "unit": "rad/s",
   "range": [
    -1.0,
    1.0
   ],
   "nominal": 0.0
  },
  {
   "name": "body_height",
   "role": "pelvis_height",
   "type": "continuous",
   "unit": "m",
   "range": [
    0.3,
    0.8
   ],
   "nominal": 0.75
  },
  {
   "name": "pitch",
   "role": "torso_pitch",
   "type": "continuous",
   "unit": "rad",
   "range": [
    -0.52,
    1.57
   ],
   "nominal": 0.0
  },
  {
   "name": "roll",
   "role": "torso_roll",
   "type": "continuous",
   "unit": "rad",
   "range": [
    -0.7,
    0.7
   ],
   "nominal": 0.0
  },
  {
   "name": "torso_yaw",
   "role": "torso_yaw",
   "type": "continuous",
   "unit": "rad",
   "range": [
    -1.57,
    1.57
   ],
   "nominal": 0.0
  }
 ],
 "modes": [],
 "binding": {
  "adapter": "sidestep_g1:make_g1c",
  "call": "dict",
  "names": {
   "vx": "vx",
   "vy": "vy",
   "wz": "wz",
   "body_height": "body_height",
   "pitch": "pitch",
   "roll": "roll",
   "torso_yaw": "torso_yaw"
  }
 },
 "doc_notes": [
  "AMO README in-distribution command ranges; play_amo.py: height command = 0.75 + offset (pelvis height), torso yaw/pitch/roll commands, vx/vy and a heading target"
 ],
 "sources": [
  "baselines/AMO/README.md",
  "baselines/AMO/play_amo.py",
  "scripts/xembody/controllers/g1_amo.py (RANGES)"
 ]
}